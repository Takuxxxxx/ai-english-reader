# ---- Server ----
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
DB_PATH=./data/app.db
# クラウド本番: Turso (https://turso.tech で無料DB作成。設定するとDB_PATHより優先)
# TURSO_DATABASE_URL=libsql://xxx.turso.io
# TURSO_AUTH_TOKEN=...

# ---- LLM provider (all free-capable) ----
# mock = no network, no key, built-in generator (default, 完全無料)
# ollama = local Ollama (free, needs `ollama serve`)
# openai-compat = any OpenAI-compatible endpoint (Ollama/Groq/Gemini-proxy/LM Studio etc.)
# anthropic = paid API (only if you set a key yourself)
LLM_PROVIDER=mock

# Ollama (free local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_ARTICLE=llama3.1:8b
OLLAMA_MODEL_WORD=llama3.1:8b

# OpenAI-compatible (free-tier endpoints can be used)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL_ARTICLE=
OPENAI_MODEL_WORD=

# Anthropic (optional, paid)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ARTICLE=claude-3-haiku-20240307
ANTHROPIC_MODEL_WORD=claude-3-haiku-20240307

# ---- Frontend ----
VITE_API_URL=http://localhost:3001
